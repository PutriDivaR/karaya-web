<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Kategori</title>
    <link rel="stylesheet" href="/css/editKategori.css">
</head>
<body>

  <%- include('../partials/sidebar', { user: user, isAdmin: isAdmin, loggedIn: true }) %>

  <div class="main-content">
    <h2>Edit Kategori</h2>

    <form action="/admin/editKategori/<%= category.id_kategori %>" method="POST">
      <label for="categoryName">Nama Kategori:</label>
      <input type="text" id="categoryName" name="categoryName" value="<%= category.nama %>" required>

      <label for="categoryDescription">Deskripsi:</label>
      <textarea id="categoryDescription" name="categoryDescription" required><%= category.deskripsi %></textarea>

      <button type="submit">Simpan Perubahan</button>
    </form>
  </div>

</body>
</html>
