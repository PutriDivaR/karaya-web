<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Kategori</title>
    <link rel="stylesheet" href="/admin.css">
    <link rel="stylesheet" href="/sidebar.css">
</head>
<body>
  <%- include('../partials/sidebar', { user: user, isAdmin: isAdmin, loggedIn: true }) %>

  <div class="main-content">
    <h2>Edit Kategori</h2>

    <div class="admin-card">
      <form class="admin-form" action="/admin/editKategori/<%= category.id_kategori %>" method="POST">
        
        <label for="categoryName">Nama Kategori</label>
        <input type="text" id="categoryName" name="categoryName" class="form-input" value="<%= category.nama %>" required>

        <label for="categoryDescription">Deskripsi</label>
        <textarea id="categoryDescription" name="categoryDescription" class="form-input" required><%= category.deskripsi %></textarea>

        <div class="button-group">
          <a href="/admin/editKategori" class="btn btn-secondary">Batal</a>
          <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
        </div>

      </form>
    </div>
  </div>

</body>
</html>