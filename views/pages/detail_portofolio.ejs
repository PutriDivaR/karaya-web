<!-- === CSS Popup === -->
<style>
.popup-papan {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex; justify-content: center; align-items: center;
  z-index: 1000;
}
.popup-content {
  background: white;
  padding: 20px;
  border-radius: 12px;
  width: 300px;
  max-height: 80vh;
  overflow-y: auto;
  color: #000;
}
#daftarPapan {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.item-papan {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 8px;
  background-color: white;
  color: #333;
}
.item-papan:hover {
  background: #f2f2f2;
}
.item-papan span {
  color: #333;
  font-weight: 500;
}
.gambar-papan {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border-radius: 6px;
}
.tombol-tambah .plus {
  width: 40px; height: 40px;
  background: #ddd;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px;
  border-radius: 6px;
}
</style>

<!-- === JavaScript === -->
<script>
function bukaPopupPapan() {
  const container = document.getElementById('daftarPapan');
  container.innerHTML = '<p>Loading...</p>';

  // Tampilkan pop-up dulu
  document.getElementById('popupPapan').style.display = 'flex';

  // Ambil data papan dari server
  fetch('/get-papan', { credentials: 'include' })
    .then(res => {
      if (!res.ok) {
        throw new Error('Belum login atau akses ditolak.');
      }
      return res.json();
    })
    .then(data => {
      container.innerHTML = ''; // Kosongkan kontainer

      // Cek apakah daftar kosong
      if (data.length === 0) {
        container.innerHTML = '<p>Tidak ada papan tersedia.</p>';
      } else {
        // Tampilkan semua papan
        data.forEach(p => {
          const item = document.createElement('div');
          item.className = 'item-papan';
          item.onclick = () => simpanKePapan(p.id_papan);
          item.innerHTML = `
            <img src="/uploads/${p.gambar || 'default.jpg'}" class="gambar-papan" />
            <span>${p.nama_papan}</span>
          `;
          container.appendChild(item);
        });
      }
    })
    .catch(err => {
      console.error('Fetch error:', err);
      container.innerHTML = `
        <p>Gagal menyimpan papan. Silakan <a href="/login" style="color: blue;">login</a> terlebih dahulu.</p>
      `;
    });
}

function tutupPopupPapan() {
  document.getElementById('popupPapan').style.display = 'none';
}

function simpanKePapan(idPapan) {
  const idPortofolio = document.getElementById('idPortofolio').value;

  fetch('/simpan-ke-papan', {
    method: 'POST',
    credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id_papan: idPapan, id_portofolio: idPortofolio })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      alert('✅ Berhasil disimpan ke papan!');
      tutupPopupPapan();
    } else {
      alert('❌ Portofolio sudah pernah disimpan.');
    }
  })
  .catch(err => {
    console.error('POST error:', err);
    alert('Terjadi kesalahan saat menyimpan.');
  });
}
</script>
<script src="/js/detail_portofolio.js"></script>





  <div class="portfolio-preview">
