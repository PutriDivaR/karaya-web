<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Kategori Baru</title>
    <link rel="stylesheet" href="/admin.css">
    <link rel="stylesheet" href="/sidebar.css">
</head>
<body>
  <%- include('../partials/sidebar', { user: user, isAdmin: isAdmin, loggedIn: true }) %>

  <div class="main-content">
    <h2>Tambah Kategori Baru</h2>

    <div class="admin-card">
        <form class="admin-form" action="/admin/tambahKategori" method="POST">
            <label for="categoryName">Nama Kategori</label>
            <input type="text" id="categoryName" name="categoryName" class="form-input" placeholder="Masukkan nama kategori" required>

            <label for="categoryDescription">Deskripsi</label>
            <textarea id="categoryDescription" name="categoryDescription" class="form-input" placeholder="Tambahkan deskripsi singkat" required></textarea>

            <div class="button-group">
                <a href="/admin/editKategori" class="btn btn-secondary">Batal</a>
                <button type="submit" class="btn btn-success">Tambah Kategori</button>
            </div>
        </form>
    </div>
  </div>

</body>
</html>