<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Komentar</title>
</head>
<body>
  <h1>Komentar untuk Portofolio ID: <%= id_portofolio %></h1>

  <% if (komentar.length === 0) { %>
    <p><%= msg %></p>
  <% } else { %>
    <ul>
      <% komentar.forEach(function(item) { %>
        <li>
          <strong><%= item.nama_pengguna %>:</strong> <%= item.isi_komentar %><br>
          <small>Ditambahkan pada: <%= item.tanggal_dibuat %></small>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
