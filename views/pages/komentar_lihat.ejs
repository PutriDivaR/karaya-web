<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Komentar</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap');
  </style>
</head>
<body style="
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: linear-gradient(135deg, #f5f1eb 0%, #e8dcc6 100%);
  margin: 0;
  padding: 20px;
  min-height: 100vh;
  color: #5d4e37;
  line-height: 1.6;
">
  
  <div style="max-width: 800px; margin: 0 auto;">
    <!-- Header -->
    <div style="
      background: linear-gradient(135deg, #8b4513 0%, #a0522d 100%);
      padding: 24px 32px;
      border-radius: 16px 16px 0 0;
      box-shadow: 0 8px 32px rgba(139, 69, 19, 0.3);
      margin-bottom: 0;
    ">
      <h1 style="
        color: #f5f1eb;
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        letter-spacing: -0.5px;
      ">
        💬 Komentar untuk Portofolio ID: <%= id_portofolio %>
      </h1>
    </div>

    <!-- Comments Section -->
    <div style="
      background: #f5f1eb;
      padding: 32px;
      border-radius: 0 0 16px 16px;
      box-shadow: 0 8px 32px rgba(139, 69, 19, 0.1);
      border: 1px solid #e8dcc6;
      border-top: none;
    ">
      
      <% if (komentar.length === 0) { %>
        <div style="
          text-align: center;
          padding: 60px 20px;
          background: linear-gradient(135deg, #f9f6f0 0%, #f0e8d8 100%);
          border-radius: 12px;
          border: 2px dashed #d4c4a8;
        ">
          <div style="
            font-size: 48px;
            margin-bottom: 16px;
            opacity: 0.6;
          ">💭</div>
          <p style="
            color: #8b4513;
            font-size: 18px;
            margin: 0;
            font-weight: 500;
          "><%= msg %></p>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <% komentar.forEach(function(item, index) { %>
            <div style="
              background: linear-gradient(135deg, #ffffff 0%, #f9f6f0 100%);
              border: 1px solid #e8dcc6;
              border-radius: 16px;
              padding: 24px;
              box-shadow: 0 4px 16px rgba(139, 69, 19, 0.08);
              transition: all 0.3s ease;
              position: relative;
              overflow: hidden;
            " onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(139, 69, 19, 0.15)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 16px rgba(139, 69, 19, 0.08)'">
              
              <!-- Decorative corner -->
              <div style="
                position: absolute;
                top: 0;
                right: 0;
                width: 40px;
                height: 40px;
                background: linear-gradient(135deg, #8b4513 0%, #a0522d 100%);
                clip-path: polygon(100% 0, 0 0, 100% 100%);
                opacity: 0.1;
              "></div>
              
              <!-- User Avatar & Name -->
              <div style="
                display: flex;
                align-items: center;
                margin-bottom: 16px;
                gap: 12px;
              ">
                <div style="
                  width: 42px;
                  height: 42px;
                  background: linear-gradient(135deg, #8b4513 0%, #a0522d 100%);
                  border-radius: 50%;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #f5f1eb;
                  font-weight: 600;
                  font-size: 16px;
                  box-shadow: 0 3px 12px rgba(139, 69, 19, 0.3);
                ">
                  <%= item.nama_pengguna.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <div style="
                    color: #8b4513;
                    font-weight: 600;
                    font-size: 16px;
                    margin-bottom: 2px;
                  ">
                    <%= item.nama_pengguna %>
                  </div>
                  <div style="
                    color: #a0522d;
                    font-size: 12px;
                    opacity: 0.8;
                  ">
                    📅 <%= item.tanggal_dibuat %>
                  </div>
                </div>
              </div>
              
              <!-- Comment Content -->
              <div style="
                background: rgba(245, 241, 235, 0.6);
                padding: 18px 20px;
                border-radius: 12px;
                border-left: 4px solid #8b4513;
                margin-left: 54px;
              ">
                <p style="
                  color: #5d4e37;
                  margin: 0;
                  font-size: 15px;
                  line-height: 1.7;
                  font-weight: 400;
                ">
                  <%= item.isi_komentar %>
                </p>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
      
      <!-- Back Button -->
      <div style="margin-top: 40px; text-align: center;">
  <button 
    onclick="window.location.href='/portofolio/detail/<%= id_portofolio %>'" 
    style="
      background: linear-gradient(135deg, #8b4513 0%, #a0522d 100%);
      color: #f5f1eb;
      border: none;
      padding: 14px 32px;
      border-radius: 25px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(139, 69, 19, 0.3);
      transition: all 0.3s ease;
      font-family: inherit;
      letter-spacing: 0.5px;
    " 
    onmouseover="
      this.style.transform='translateY(-2px)';
      this.style.boxShadow='0 8px 25px rgba(139, 69, 19, 0.4)';
      this.style.background='linear-gradient(135deg, #a0522d 0%, #8b4513 100%)';
    " 
    onmouseout="
      this.style.transform='translateY(0)';
      this.style.boxShadow='0 6px 20px rgba(139, 69, 19, 0.3)';
      this.style.background='linear-gradient(135deg, #8b4513 0%, #a0522d 100%)';
    " 
    onmousedown="this.style.transform='translateY(1px)'" 
    onmouseup="this.style.transform='translateY(-2px)'">
    ← Kembali ke Detail Portofolio
  </button>
</div>

  
  <!-- Floating decorative elements -->
  <div style="
    position: fixed;
    top: 20%;
    right: 5%;
    width: 60px;
    height: 60px;
    background: radial-gradient(circle, rgba(139, 69, 19, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: -1;
  "></div>
  
  <div style="
    position: fixed;
    bottom: 30%;
    left: 8%;
    width: 40px;
    height: 40px;
    background: radial-gradient(circle, rgba(160, 82, 45, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: -1;
  "></div>
</body>
</html>