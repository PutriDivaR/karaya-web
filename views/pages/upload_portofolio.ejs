<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= portofolio ? 'Draft' : 'Upload' %> Portofolio</title>
    <link rel="stylesheet" href="/upload_portofolio.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>
    </div>
    
    <div class="main-content">
        <h2><%= portofolio ? 'Draft' : 'Upload' %> Portofolio</h2>
        <div class="upload-container">
            <form class="form" method="POST" action="/upload_portofolio" enctype="multipart/form-data">
                <input type="hidden" name="id_portofolio" value="<%= portofolio ? portofolio.id_portofolio : '' %>">
                
                <div class="form-row">
                    <div class="form-column image-column">
                        <label for="imageUpload" class="image-upload-label">
                            <div class="image-preview" id="imagePreview">
                                <% if (portofolio && portofolio.gambar) { %>
                                    <img id="imageDisplay" src="/uploads/<%= portofolio.gambar %>" alt="Portofolio Image" />
                                <% } else { %>
                                    <div id="uploadPlaceholder">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <p>Pilih gambar atau seret ke sini</p>
                                        <span>PNG, JPG, JPEG</span>
                                    </div>
                                <% } %>
                            </div>
                        </label>
                        <input class="file-input" type="file" name="gambar" id="imageUpload" accept="image/*" />
                    </div>

                    <div class="form-column input-column">
                        <label for="judul">Judul</label>
                        <input type="text" id="judul" name="judul" class="form-input" placeholder="Masukkan judul portofolio" value="<%= portofolio ? portofolio.judul : '' %>" required>

                        <label for="deskripsi">Deskripsi</label>
                        <textarea id="deskripsi" name="deskripsi" class="form-input" placeholder="Tambahkan deskripsi singkat" required><%= portofolio ? portofolio.deskripsi : '' %></textarea>

                        <label for="kategori">Kategori</label>
                        <select id="kategori" name="id_kategori" class="form-input" required>
                            <option value="">-- Pilih Kategori --</option>
                            <% categories.forEach(function(category) { %>
                                <option value="<%= category.id_kategori %>" <%= (portofolio && portofolio.id_kategori == category.id_kategori) ? 'selected' : '' %>><%= category.nama %></option>
                            <% }); %>
                        </select>

                        <div class="button-group">
                            <button type="submit" name="is_draft" value="1" class="upload-button secondary">Simpan Draft</button>
                            <button type="submit" name="is_draft" value="0" class="upload-button primary">Upload</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('imageUpload');
    const imagePreview = document.getElementById('imagePreview');
    const placeholder = document.getElementById('uploadPlaceholder');

    fileInput.addEventListener('change', function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                // Clear placeholder
                if (placeholder) {
                    imagePreview.innerHTML = '';
                }
                
                // Find or create image display
                let imageDisplay = document.getElementById('imageDisplay');
                if (!imageDisplay) {
                    imageDisplay = document.createElement('img');
                    imageDisplay.id = 'imageDisplay';
                    imagePreview.appendChild(imageDisplay);
                }
                
                imageDisplay.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });
});
</script>
</body>
</html>