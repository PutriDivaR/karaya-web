<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Portofolio</title>
    <link rel="stylesheet" href="/upload_portofolio.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>
    </div>
    
    <div class="main-content">
        <h2>Edit Portofolio Yang Telah diupload</h2>
        <div class="upload-container">
            <form class="form" method="POST" action="/edit_portofolio" enctype="multipart/form-data">
                <input type="hidden" name="id_portofolio" value="<%= portofolio.id_portofolio %>">
                
                <div class="form-row">
                    <div class="form-column image-column">
                        <label for="imageUpload" class="image-upload-label">
                            <div class="image-preview" id="imagePreview">
                                <!-- Existing image is shown by default -->
                                <img id="imageDisplay" src="/uploads/<%= portofolio.gambar %>" alt="Portofolio Image" />
                            </div>
                        </label>
                        <input class="file-input" type="file" name="gambar" id="imageUpload" accept="image/*" />
                    </div>

                    <div class="form-column input-column">
                        <label for="judul">Judul</label>
                        <input type="text" id="judul" name="judul" class="form-input" placeholder="Masukkan judul portofolio" value="<%= portofolio.judul %>" required>

                        <label for="deskripsi">Deskripsi</label>
                        <textarea id="deskripsi" name="deskripsi" class="form-input" placeholder="Tambahkan deskripsi singkat" required><%= portofolio.deskripsi %></textarea>

                        <label for="kategori">Kategori</label>
                        <select id="kategori" name="id_kategori" class="form-input" required>
                            <option value="">-- Pilih Kategori --</option>
                            <% categories.forEach(function(category) { %>
                                <!-- Set selected if category matches -->
                                <option value="<%= category.id_kategori %>" <%= (portofolio && portofolio.id_kategori == category.id_kategori) ? 'selected' : '' %>>
                                    <%= category.nama %>
                                </option>
                            <% }); %>
                        </select>

                        <div class="button-group">
                             <a href="/portofolio/hapus/<%= portofolio.id_portofolio %>" class="upload-button secondary" onclick="return confirm('Apakah Anda yakin ingin menghapus portofolio ini?');">Hapus</a>
                            <button type="submit" class="upload-button primary">Simpan Perubahan</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('imageUpload');
    const imagePreview = document.getElementById('imagePreview');
    
    fileInput.addEventListener('change', function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                let imageDisplay = document.getElementById('imageDisplay');
                // If the img element doesn't exist, create it
                if (!imageDisplay) {
                    imageDisplay = document.createElement('img');
                    imageDisplay.id = 'imageDisplay';
                    imagePreview.innerHTML = ''; // Clear any placeholder text/icons
                    imagePreview.appendChild(imageDisplay);
                }
                imageDisplay.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });
});
</script>
</body>
</html>